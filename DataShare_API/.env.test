# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Symfony ne charge deliberement pas .env.local en test, pour que les tests
# donnent le meme resultat partout : la passphrase des cles de developpement
# n'est donc pas disponible ici. Les tests signent avec une paire de cles qui
# leur est propre, sans passphrase, generee par "make test-keys".
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private-test.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public-test.pem
JWT_PASSPHRASE=
